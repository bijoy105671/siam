DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/siam_air
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=4000
NODE_ENV=production
TZ=Asia/Dhaka

# Used only by: npm run db:bootstrap-admin
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-long-password-at-least-12-characters
ADMIN_FULL_NAME=SIAM AIR Administrator

# Production frontend build must use the server API
VITE_USE_SERVER_API=true
